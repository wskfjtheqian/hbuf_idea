<script setup lang="ts">
import {objectAssign, tryCatch} from "@/public/utils";
import {ref} from "vue";
import {onMounted, onUnmounted, ref} from "vue";
import router, {goBack} from "@/router";
    #if (${genAdd} == true || ${genSet} == true)
    import {AdminPower} from "@/hbuf/power.enum";
    #end
import {ElMessage, useLocale} from "element-plus";
import type {FormInstance} from "element-plus";
    #if (${genAdd} == true || ${genSet} == true)
    import {power} from "@/public/directive.ts";
    #end
import NetApi from "@/public/NetApi.ts";
    #if (${genAdd} == true || ${genSet} == true)
    import {EventBus, EventMsg} from "@/public/event.ts";
    #end
import {${dataName}} from "@/hbuf/${goPackage}.data";
import {${dataName}FormItems} from "@/hbuf/${goPackage}.ui";
import {
  type ${util.upperFirst(${goPackage})}Manage,
        ${util.upperFirst(${goPackage})}ManageClient
} from "@/hbuf/${goPackage}.manage.server.ts";
    #if (${genAdd} == true || ${genGet} == true || ${genSet} == true)
    import {
        #if (${genAdd} == true)
          MgAdd${dataName}Req,
        #end
        #if (${genGet} == true)
          MgGet${dataName}Req,
        #end
        #if (${genAdd} == true)
          MgInit${dataName}Req,
        #end
        #if (${genSet} == true)
          MgSet${dataName}Req
        #end
    } from "@/hbuf/${goPackage}.manage.data.ts";
    #end
const ${goPackage}Api: ${util.upperFirst(${goPackage})}Manage = new ${util.upperFirst(${goPackage})}ManageClient(NetApi.instance.client)
const locale = useLocale()
const formRef = ref<FormInstance>()
const form = ref<${dataName}>(new ${dataName}())
const isAdd = ref(false)
const current = router.currentRoute.value.params

let initValue: ${dataName} | null
#if (${genAdd} == true)
let token: string | null = null
#end

const init = () => {
  isAdd.value = current.id == "create" && current.name == "New"
  if (isAdd.value) {
      #if (${genAdd} == true)
        tryCatch({}, async () => {
          const resp = await ${goPackage}Api.mgInit${dataName}(new MgInit${dataName}Req())
          form.value = (initValue = resp.info!).clone()
          token = resp.token
        })
      #end
  } else {
    let req = new MgGet${dataName}Req();
    req.${util.lowerFirst(${util.underlineToCamel(${dbIndex})})} = BigInt(current.id as string)
    tryCatch({}, async () => {
      const resp = await ${goPackage}Api.mgGet${dataName}(req)
      form.value = (initValue = resp.info!).clone()
    })
  }
}
onMounted(init)

onUnmounted(init)

    #if (${genAdd} == true)
    const handleAdd = async (ref: FormInstance | undefined) => {
      if (!await ref!.validate()) return
      await tryCatch({}, async () => {
        const req = objectAssign(new MgAdd${dataName}Req(), form.value)
        req.token = token!
        await ${goPackage}Api.mgAdd${dataName}(req)
      })
      EventBus.$emit(EventMsg.refresh${dataName}List)
      ElMessage.success(locale.t("public.addSuccessfully"))
      goBack()
    }
    #end

    #if (${genSet} == true)
    const handleSave = async (ref: FormInstance | undefined) => {
      if (!await ref!.validate()) return
      const {change, fields} = form.value.$getChangeField(initValue!, "")
      if (fields.length == 0) {
        ElMessage.warning(locale.t("public.notChange"))
        return
      }

      if (!await ref!.validate()) return
      await tryCatch({}, async () => {
        const req = objectAssign(new MgSet${dataName}Req(), change)
        req.changeFields = fields
        req.${util.lowerFirst(${util.underlineToCamel(${dbIndex})})} = form.value.${util.lowerFirst(${util.underlineToCamel(${dbIndex})})}
        await ${goPackage}Api.mgSet${dataName}(req)
      })
      EventBus.$emit(EventMsg.refresh${dataName}List)
      ElMessage.success(locale.t("public.modifiedSuccessfully"))
      goBack()
    }
    #end

    #if (${genAdd} == true || ${genSet} == true)
    const handleReset = (ref: FormInstance | undefined) => {
      form.value = initValue!.clone()
    }
    #end

</script>

<template>
  <el-scrollbar class="app-form-page">

    <el-form ref="formRef" :model="form" label-width="auto"
        #if (${genAdd} == true && ${genSet} == true)
             :disabled="!power([AdminPower.ADD${util.camelToUnderline(${dataName}).toUpperCase()}, AdminPower.SET${util.camelToUnderline(${dataName}).toUpperCase()}])"
        #elseif (${genAdd} == true)
             :disabled="!power([AdminPower.ADD${util.camelToUnderline(${dataName}).toUpperCase()}])"
        #elseif (${genSet} == true)
             :disabled="!power([AdminPower.SET${util.camelToUnderline(${dataName}).toUpperCase()}])"
        #else
             :disabled="true"
        #end
    >
      <${util.camelToMiddleLine(${dataName}).toLowerCase()}-form-items :model="form" :isAdd="isAdd">
      </${util.camelToMiddleLine(${dataName}).toLowerCase()}-form-items>
        #if (${genAdd} == true || ${genSet} == true)
        <el-affix position="bottom" :offset="26">
          <el-form-item label=" ">
              #if (${genAdd} == true)
                <el-button type="primary" @click="handleAdd(formRef)" v-if="isAdd"
                           v-power="[AdminPower.ADD${util.camelToUnderline(${dataName}).toUpperCase()}]">{{
                    $t('public.create')
                  }}
                </el-button>
              #end
              #if (${genSet} == true)
                <el-button type="primary" @click="handleSave(formRef)" v-if="!isAdd"
                           v-power="[AdminPower.SET${util.camelToUnderline(${dataName}).toUpperCase()}]">{{
                    $t('public.save')
                  }}
                </el-button>
              #end
            <el-button @click="handleReset(formRef)"
                       v-power="[AdminPower.ADD${util.camelToUnderline(${dataName}).toUpperCase()},AdminPower.SET${util.camelToUnderline(${dataName}).toUpperCase()}]">
              {{ $t('public.reset') }}
            </el-button>
          </el-form-item>
        </el-affix>
        #end
    </el-form>
  </el-scrollbar>
</template>

<style scoped>
  .el-form {
    padding: 16px;
  }
</style>
