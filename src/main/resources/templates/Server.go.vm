	}

	return &${goPackage}.Status${dataName}Resp{}, nil
}
#end

#if (${genExport} == true)
// Export${dataName} #if(${comment})导出${comment}#end
func (s *Server) Export${dataName}(ctx context.Context, req *${goPackage}.Export${dataName}Req) (*${goPackage}.Export${dataName}Resp, error) {
	url, err := utils.ExportExcel[${goPackage}.${dataName}](ctx, req, "", "${dataName}", nil)
	if err != nil {
		return nil, err
	}
	return &${goPackage}.Export${dataName}Resp{Url: url}, nil
}
#end

