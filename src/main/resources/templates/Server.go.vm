package ${goPackage}

type Server struct {
}

// Get${dataName} #if(${comment})获得${comment}#end

func (s *Server) Get${dataName}(ctx context.Context, req *${goPackage}.Get${dataName}Req) (*${goPackage}.Get${dataName}Resp, error) {
	info, err := ${goPackage}.${dataName}{$util.upperFirst($util.underlineToCamel($dbIndex)): &req.$util.upperFirst($util.underlineToCamel($dbIndex))}.DbGet(ctx)
	if err != nil {
		return nil, err
	}

	return &${goPackage}.Get${dataName}Resp{Info: info}, nil
}

// Add${dataName} #if(${comment})添加${comment}#end

func (s *Server) Add${dataName}(ctx context.Context, req *${goPackage}.Add${dataName}Req) (*${goPackage}.Add${dataName}Resp, error) {
	id, err := s.app. $util.lowerFirst($util.underlineToCamel($dbIndex)) .NextId(ctx)
	if err != nil {
		return nil, err
	}

	req.Info.Set$util.upperFirst($util.underlineToCamel($dbIndex))(id)
	req.Info.SetAddTime(hbuf.Time(time.Now()))
	_, _, err = req.Info.DbInsert(ctx)
	if err != nil {
		return nil, err
	}

	return &${goPackage}.Add${dataName}Resp{}, nil
}

// Set${dataName} #if(${comment})修改${comment}#end

func (s *Server) Set${dataName}(ctx context.Context, req *${goPackage}.Set${dataName}Req) (*${goPackage}.Set${dataName}Resp, error) {
	count, _, err := req.Info.DbUpdate(ctx)
	if err != nil {
		return nil, err
	}
	if count == 0 {
		return nil, utils.NewError(erros.ErrorCodeIdError)
	}

	return &${goPackage}.Set${dataName}Resp{}, nil
}

// Del${dataName} #if(${comment})删除${comment}#end

func (s *Server) Del${dataName}(ctx context.Context, req *${goPackage}.Del${dataName}Req) (*${goPackage}.Del${dataName}Resp, error) {
	count, _, err := req.DbDel(ctx)
	if err != nil {
		return nil, err
	}
	if count == 0 {
		return nil, utils.NewError(erros.ErrorCodeIdError)
	}

	return &${goPackage}.Del${dataName}Resp{}, nil
}

// Get${dataName}List #if(${comment})获得${comment}列表#end

func (s *Server) List${dataName}(ctx context.Context, req *${goPackage}.List${dataName}Req) (*${goPackage}.List${dataName}Resp, error) {
	count, err := req.DbCount(ctx)
	if nil != err {
		return nil, err
	}

	if 0 == count {
		return &${goPackage}.List${dataName}Resp{List: make([]${goPackage}.${dataName}, 0)}, nil
	}
	list, err := req.DbList(ctx)
	if nil != err {
		return nil, err
	}

	return &${goPackage}.List${dataName}Resp{List: list, Total: int32(count)}, nil
}

// Status${dataName} #if(${comment})修改${comment}状态#end

func (s *Server) Status${dataName}(ctx context.Context, req *${goPackage}.Status${dataName}Req) (*${goPackage}.Status${dataName}Resp, error) {
	_, _, err := req.DbSet(ctx)
	if err != nil {
		return nil, err
	}

	return &${goPackage}.Status${dataName}Resp{}, nil
}

// Export${dataName} #if(${comment})导出${comment}#end

func (s *Server) Export${dataName}(ctx context.Context, req *version.Export${dataName}Req) (*version.Export${dataName}Resp, error) {
	url, err := utils.ExportExcel[version.${dataName}](ctx, req, "", "${dataName}")
	if err != nil {
		return nil, err
	}
	return &version.Export${dataName}Resp{Url: url}, nil
}
